{
  "name": "thapar-connect",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "test": "node --env-file-if-exists=.env --test tests/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/client": "6.19.3",
    "@vercel/analytics": "1.6.1",
    "better-auth": "1.7.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.4.6",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}

